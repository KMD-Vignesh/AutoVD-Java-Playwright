<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.framework.utils.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.framework.tests.LoginBrowserTest"/>
        </classes>
    </test>

    <test name="E2E Tests">
        <classes>
            <class name="com.framework.tests.E2EBrowserTest"/>
        </classes>
    </test>
</suite>