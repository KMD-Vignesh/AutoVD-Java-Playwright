<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite - Chromium" parallel="methods" thread-count="4">
    <listeners>
        <listener class-name="com.framework.utils.TestListener"/>
    </listeners>
    
    <param name="browser">chromium</param>

    <test name="Login Tests - Chromium" parallel="methods" thread-count="2">
        <classes>
            <class name="com.framework.tests.LoginBrowserTest"/>
        </classes>
    </test>

    <test name="E2E Tests - Chromium" parallel="methods" thread-count="2">
        <classes>
            <class name="com.framework.tests.E2EBrowserTest"/>
        </classes>
    </test>
</suite>