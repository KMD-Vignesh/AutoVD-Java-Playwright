<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite - WebKit" parallel="methods" thread-count="4">
    <listeners>
        <listener class-name="com.framework.utils.TestListener"/>
    </listeners>

    <test name="Login Tests - WebKit" parallel="methods" thread-count="2">
        <classes>
            <class name="com.framework.tests.LoginBrowserTest">
                <methods>
                    <include name="testSuccessfulLogin_AsStandardUser"/>
                    <include name="testFailedLogin_AsLockedOutUser"/>
                    <include name="testFailedLogin_AsInvalidUser"/>
                    <include name="testFailedLogin_WithEmptyCredentials"/>
                    <include name="testLoginPageLoads"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="E2E Tests - WebKit" parallel="methods" thread-count="2">
        <classes>
            <class name="com.framework.tests.E2EBrowserTest">
                <methods>
                    <include name="testCompletePurchaseFlow"/>
                    <include name="testLogoutFlow"/>
                    <include name="testVerifyInventoryItems"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>